# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).
# Load order: the app reads these as environment variables.

# Data source: "synthetic" (default, no DB needed) or "live"
DATA_SOURCE=synthetic

HISTORY_MONTHS=24

# --- Pilot scoping (the catalogue is ~14k items; scope the first run) ---------
# CRM_DIVISION matches item Segment2, e.g. "PNC Division" or "Textile & Paper
# Division". Leave blank for all divisions.
CRM_DIVISION=
# ACTIVE_ONLY=yes keeps only items with dispatch history in the window.
ACTIVE_ONLY=yes
# MAX_SKUS caps to the top-N items by shipped volume (0 = no cap).
MAX_SKUS=300
# Default production batch / lot multiple until a real batch master is available.
DEFAULT_BATCH=100

# --- Data files (no Oracle; auto-discovered from the project root) ------------
# OPTIONAL -- if unset, the tool auto-discovers these by name in the project root:
#   STOCK_XLSX -> Pure_Stock_Agings*.xlsx   BOM_XLSX -> BOM_Planning_Tool*.xlsx
#   PO_CSV     -> Pure_PO_Receipts*.csv     BUSINESS_PLAN_XLSX -> PCBusinessPlan*.xlsx
# (Sample_Data.xlsx is NOT used -- only a tiny sample of the stock export.)
# STOCK_XLSX=
# BOM_XLSX=
# PO_CSV=
# BUSINESS_PLAN_XLSX=
# Business-plan accounting year to read (blank = all rows).
# BP_ACCYEAR=2026-2027
# Pending-SOC window: undispatched qty on OPEN orders created in the last N months
# (read-only replication of SP_SOCSummaryReport). Lower = nearer-term firm demand.
SOC_WINDOW_MONTHS=6

# --- CRM (SQL Server, CRMPROD) -------------------------------------------------
# pyodbc needs the INSTALLED ODBC driver name. Check with:
#   Get-OdbcDriver | Select-Object Name
# On this machine it is "ODBC Driver 18 for SQL Server".
CRM_DB_DRIVER=ODBC Driver 18 for SQL Server
CRM_DB_SERVER=10.1.0.146
CRM_DB_PORT=1433
CRM_DB_NAME=CRMPROD
CRM_DB_USER=readuser
CRM_DB_PASSWORD=
CRM_DB_TRUSTED_CONNECTION=no
# Which item Segment column is the planning "family". Segment1 is filtered to
# 'Performance Chemicals'; Segment2 = Division, Segment3 = product family.
CRM_FAMILY_SEGMENT=Segment3

DB_TIMEOUT=15
